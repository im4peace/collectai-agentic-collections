# CollectAI backend environment variables (synthetic/demo project — see CLAUDE.md).
# Copy this file to .env and fill in local values. Never commit .env.

# Provider mode: MOCK (default, no external calls) or LIVE.
LLM_MODE=MOCK

# Claude model identifier, required only when LLM_MODE=LIVE. Never hard-code
# a real model id in source; this is the only place it is configured.
ANTHROPIC_MODEL=claude-REPLACE_ME

# Anthropic API key, required only when LLM_MODE=LIVE. Placeholder only — a
# real key must never be committed.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# OpenRouter credentials, used only by collectai_eval's LIVE evaluation CLI
# (`python -m collectai_eval run --mode live --live-confirm --provider openrouter`),
# never by the application/server LLM runtime, and never read unless
# --provider openrouter is passed. OPENROUTER_MODEL must be set explicitly —
# there is no dynamic/auto-router default (e.g. "openrouter/auto") — and must
# end in ":free"; a model id that doesn't is refused before any provider call
# or network access, to prevent accidental paid-model usage. Placeholders
# only — a real key must never be committed.
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_MODEL=vendor/model-REPLACE_ME:free

# Maximum AI tool calls allowed per conversation turn (1-20, default 5).
TOOL_CALL_CAP_PER_TURN=5

# Retries after schema-invalid AI output or a provider timeout (0-2, default 1).
AI_RETRY_BOUND=1

# Clarification questions allowed before an UNRESOLVED_UNKNOWN escalation (0-5, default 2).
MAX_CLARIFICATION_TURNS=2

# Chat requests allowed per minute (1-600, default 20).
CHAT_RATE_LIMIT_PER_MINUTE=20

# General API requests allowed per minute (1-6000, default 300).
API_RATE_LIMIT_PER_MINUTE=300

# Timeout for a single LLM provider call, in seconds (1-120, default 20).
PROVIDER_TIMEOUT_SECONDS=20

# Minutes a customer-visible proposal stays valid before expiring (1-1440, default 30).
PROPOSAL_TTL_MINUTES=30

# Enables demo-only controls (simulated clock, reseed, etc.). Never enable in a
# real deployment.
DEMO_CONTROLS_ENABLED=false

# PostgreSQL connection string (async driver), used by the `api` service.
# Required. Local/demo value only, matches docker-compose.yml's `db` service
# and the role passwords below. Running the backend outside Docker against a
# locally installed Postgres: replace `db` with `localhost`.
DATABASE_URL=postgresql+asyncpg://collectai_app:change-me@db:5432/collectai

# PostgreSQL role passwords (docker-compose.yml's `db` service applies these
# via deploy/db/init-app-passwords.sh on first container start; the
# `migrate` service connects as collectai_owner instead of the app role
# above). Synthetic/demo values only -- never a real credential, and change
# these before exposing any port beyond localhost.
POSTGRES_SUPERUSER_PASSWORD=change-me
COLLECTAI_OWNER_PASSWORD=change-me
COLLECTAI_APP_PASSWORD=change-me
COLLECTAI_READONLY_PASSWORD=change-me

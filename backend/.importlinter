; import-linter contracts (folder-structure.md section 5).
;
; Only one contract is defined here: `rules_engine` (layer 4a, owned by
; E2-S1) must not import AI/LLM packages or any higher layer -- this is what
; AC5 actually requires. Its forbidden-module list includes packages that do
; not exist yet (e.g. `ai_orchestration`, `application`) on purpose --
; import-linter passes trivially against a module with no source files, and
; the contract is then already correct the moment that package is created by
; a later story, with no edit needed here.
;
; `types` and `config` contracts (layers 0 and 1) are intentionally NOT
; defined here even though they conceptually belong in this file per
; folder-structure.md section 5: both packages currently ship as PEP 420
; implicit namespace packages (no `__init__.py`; owned by a sibling story,
; out of scope for this run to add one), and import-linter's `forbidden`
; contract type hard-errors ("Module 'collectai.types' does not exist")
; when a `source_modules` entry isn't a real package in grimp's import
; graph. Add those two contracts once `types/__init__.py` and
; `config/__init__.py` exist.
;
; `llm_provider` (layer 4a sibling) gets its own contract from E5-S1, added
; as a separate, additive section in this same file.
;
; `ai_orchestration` (layer 5b, E5-S4) gets its own contract below, now that
; the package imports `llm_provider` for real: it must never import
; `rules_engine`, `domain_services`, `persistence`, `api`, `application` or
; `bootstrap`. `llm_provider` is deliberately NOT in its forbidden list --
; `ai_orchestration` legitimately imports it elsewhere (E5-S1/E5-S2).
; `tests/architecture/test_e5_s3_ai_orchestration_isolated.py`'s docstring
; explains why this durable contract did not exist before this story.
;
; `collectai_eval` (E10-S1) is a separate root package (`collectai_eval`,
; not `collectai.something`), not `include_external_packages`-visible to a
; contract whose `root_package` is `collectai` -- no contract here can
; express "collectai must not import collectai_eval" the way every other
; contract expresses a boundary within `collectai` itself.
; `tests/architecture/test_e10_s1_eval_isolation.py`'s hand-rolled AST scan
; is this boundary's real, durable enforcement (mirroring
; `test_e5_s3_ai_orchestration_isolated.py`'s own precedent for exactly
; this "not yet expressible via `.importlinter`" situation).

[importlinter]
root_package = collectai
include_external_packages = True

[importlinter:contract:rules-engine-no-ai-or-higher-layers]
name = rules_engine (layer 4a) must not import AI/LLM packages or any higher layer
type = forbidden
source_modules =
    collectai.rules_engine
forbidden_modules =
    collectai.ai_orchestration
    collectai.llm_provider
    collectai.persistence
    collectai.audit
    collectai.domain_services
    collectai.application
    collectai.api
    collectai.jobs
    collectai.bootstrap

[importlinter:contract:ai-orchestration-no-rules-engine-or-higher-layers]
name = ai_orchestration (layer 5b) must not import rules_engine, domain_services, persistence, api, application or bootstrap
type = forbidden
source_modules =
    collectai.ai_orchestration
forbidden_modules =
    collectai.rules_engine
    collectai.domain_services
    collectai.persistence
    collectai.api
    collectai.application
    collectai.bootstrap
    collectai.jobs
; `audit` is an allowed layer-5b import (folder-structure.md: "AI: types,
; config, audit, llm_provider") and `audit.service` itself needs the
; `audit_event` ORM class to write rows -- that single edge is `persistence`
; only by transitivity through an already-sanctioned dependency, not a
; boundary violation of `ai_orchestration` itself, so it is excluded here
; rather than dropping `persistence` from `forbidden_modules` wholesale.
ignore_imports =
    collectai.audit.service -> collectai.persistence.orm.audit_event
